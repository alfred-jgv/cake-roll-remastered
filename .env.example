# Copy to `.env` and fill in values from your Supabase project.
# One file is used by Next.js and the Prisma CLI.

# Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Session pooler or direct connection (port 5432). Used by migrate and seed.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_PRODUCT_BUCKET="product-images"

# Optional until later phases
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
ADMIN_EMAILS=""
